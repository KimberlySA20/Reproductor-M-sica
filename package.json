{
  "name": "music-streamer",
  "version": "2.0.0",
  "description": "Modern distributed music streaming platform",
  "private": true,
  "workspaces": [
    "client",
    "server", 
    "workers",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:worker\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server", 
    "dev:worker": "npm run dev --workspace=workers",
    "build": "npm run build --workspaces",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:worker": "npm run build --workspace=workers",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\" \"npm run start:worker\"",
    "start:client": "npm run start --workspace=client",
    "start:server": "npm run start --workspace=server",
    "start:worker": "npm run start --workspace=workers",
    "install:all": "npm install --workspaces",
    "clean": "npm run clean --workspaces",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose up"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
